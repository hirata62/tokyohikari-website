{
  "name": "tokyohikari-website",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    // 既定では静的ファイルがワーカーより先に配信されるため、/company のような
    // ページでworker.jsのリダイレクト（www無し・httpの正規化）が動かない。
    // ワーカーを先に通し、最後の env.ASSETS.fetch() でファイルを返す。
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      // run_worker_first により画像・CSS等の読み込みも1件ずつ記録されてしまうため、
      // リクエストごとの自動記録は止める。worker.js の console.log
      // （お問い合わせフォームの失敗記録）は引き続き残る。
      // 2026-12-01 から Observability がログ量に応じた課金になったことへの対応。
      "invocation_logs": false
    }
  }
}
